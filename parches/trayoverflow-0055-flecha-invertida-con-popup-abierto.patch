   gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (p->arrow), active);
   p->updating_arrow = FALSE;
+  arrow_update_icon (p);
 
   /* Con el popup abierto, el tooltip de la flecha solo estorba */
   gtk_widget_set_has_tooltip (p->arrow, !active);
