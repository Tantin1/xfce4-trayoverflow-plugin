diff --git a/src/to-settings.c b/src/to-settings.c
index 956ae37..0389e1c 100644
--- a/src/to-settings.c
+++ b/src/to-settings.c
@@ -813,6 +813,28 @@ tray_settings_set_new_in_popup (TraySettings *s, gboolean value)
 
 /* ── Visibilidad ─────────────────────────────────────────────────────── */
 
+/* Claves ocultas a mano, separadas por comas (para el proxy) */
+gchar *
+tray_settings_get_hidden_csv (TraySettings *s)
+{
+  GString *out = g_string_new (NULL);
+  GHashTableIter iter;
+  gpointer key;
+
+  g_return_val_if_fail (TRAY_IS_SETTINGS (s), g_string_free (out, FALSE));
+
+  g_hash_table_iter_init (&iter, s->hidden);
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    {
+      if (out->len > 0)
+        g_string_append_c (out, ',');
+      g_string_append (out, key);
+    }
+  return g_string_free (out, FALSE);
+}
+
+
+
 gboolean
 tray_settings_is_hidden (TraySettings *s,
                          const gchar  *key,
