@@ -21,6 +21,8 @@ struct _TrayButton
   GtkWidget *image;
   gint       icon_size;
   gboolean   sized;            /* ya recibió su tamaño real */
+  gint       min_width;        /* espacio mínimo para la imagen (0 = el del ícono) */
+  gint       min_height;
 
