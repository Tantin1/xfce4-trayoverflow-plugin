+/* Una app terca que vuelve a pedir su tamaño cada vez que le avisamos el
+ * nuestro armaría un ida y vuelta sin fin: pasado el límite, se la ignora
+ * hasta el segundo siguiente */
+static gboolean
+icon_too_many_requests (Icon *icon)
+{
+  gint64 now = g_get_monotonic_time ();
+
+  if (now - icon->cfg_since > G_USEC_PER_SEC)
+    {
+      icon->cfg_since = now;
+      icon->cfg_count = 0;
+    }
+
+  if (++icon->cfg_count == CFG_REQUEST_LIMIT + 1)
+    LOG ("0x%lx pide otro tamaño sin parar: se ignora por un segundo\n", icon->win);
+
+  return icon->cfg_count > CFG_REQUEST_LIMIT;
+}
