+/* Fin de la espera sin que la app volviera: ahora sí se quita */
+static gboolean
+icon_wait_expired (gpointer data)
+{
+  Icon *icon = data;
+
+  icon->expire_id = 0;
+  P.waiting = g_list_remove (P.waiting, icon);
+  LOG ("fin de la espera de %s: se quita\n", icon->id);
+  icon_free_struct (icon);
+  return G_SOURCE_REMOVE;
+}
+
+
+
+/* Una ventana nueva de una app cuya ventana anterior está en espera
+ * (GtkStatusIcon destruye y crea la ventana al ocultarse y mostrarse):
+ * hereda su conexión, así para el panel es el mismo ícono y no se rehace
+ * nada. Hasta que se dibuje, contesta con la imagen anterior. */
+static void
+icon_adopt_waiting (Icon *icon)
+{
+  GList *l;
+  Icon *old = NULL;
+
+  if (icon->id == NULL)
+    return;
+
+  for (l = P.waiting; l != NULL; l = l->next)
+    if (g_strcmp0 (((Icon *) l->data)->id, icon->id) == 0)
+      {
+        old = l->data;
+        break;
+      }
+  if (old == NULL)
+    return;
+
+  P.waiting = g_list_remove (P.waiting, old);
+  g_source_remove (old->expire_id);
+  old->expire_id = 0;
+
+  if (old->reg_id != 0)
+    g_dbus_connection_unregister_object (old->conn, old->reg_id);
+  if (old->reg_size_id != 0)
+    g_dbus_connection_unregister_object (old->conn, old->reg_size_id);
+  old->reg_id = old->reg_size_id = 0;
+
+  icon->conn = old->conn;
+  old->conn = NULL;
+  if (!icon_export (icon))
+    icon_unpublish (icon);
+
+  icon->pixels = old->pixels;
+  icon->img_w = old->img_w;
+  icon->img_h = old->img_h;
+  old->pixels = NULL;
+
+  LOG ("0x%lx hereda el ícono de %s\n", icon->win, icon->id);
+  icon_free_struct (old);
+
+  /* Si la ventana nueva nace oculta, se quita con la espera de siempre */
+  if (!icon->xembed_mapped && icon->conn != NULL)
+    icon->hide_id = g_timeout_add (HIDE_DELAY_MS, icon_hide_timeout, icon);
+}
