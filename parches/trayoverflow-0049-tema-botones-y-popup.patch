+
+static void
+tray_menu_frame_class_init (TrayMenuFrameClass *klass)
+{
+  gtk_widget_class_set_css_name (GTK_WIDGET_CLASS (klass), "menu");
+}
+
+static void
+tray_menu_frame_init (TrayMenuFrame *self)
+{
+  (void) self;
+}
