+  TRAY_ITEM_CHANGE_ICON   = 1 << 0,  /* ícono, píxeles, carpeta de íconos */
+  TRAY_ITEM_CHANGE_TEXT   = 1 << 1,  /* título o tooltip */
+  TRAY_ITEM_CHANGE_STATUS = 1 << 2,  /* activo / pasivo / pide atención */
