 void
 tray_item_emit_changed (TrayItem *item)
 {
+  TrayItemPrivate *priv;
+
   g_return_if_fail (TRAY_IS_ITEM (item));
+  priv = PRIV (item);
+
+  /* La app avisó, pero no cambió nada que se vea */
