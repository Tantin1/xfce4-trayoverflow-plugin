diff --git a/src/to-settings.c b/src/to-settings.c
index 0b86093..f9e7abc 100644
--- a/src/to-settings.c
+++ b/src/to-settings.c
@@ -806,13 +806,50 @@ tray_settings_move (TraySettings *s,
 
 /* ── Ícono elegido ───────────────────────────────────────────────────── */
 
+/* Apps cuyo ícono se ve roto en cualquier bandeja: se usa el de su tema o
+ * el que instala su paquete (hicolor, pixmaps). Si no existe, el de la app. */
+static const gchar *
+default_icon_for (const gchar *key)
+{
+  /* JDownloader (Java): su ícono sale como puntos sueltos o un cuadrado
+   * blanco. La clave es su WM_CLASS ("org-jdownloader-update-launcher-…") */
+  if (g_str_has_prefix (key, "org-jdownloader-"))
+    return "jdownloader";
+
+  return NULL;
+}
+
+
+
+const gchar *
+tray_settings_get_icon_choice (TraySettings *s,
+                               const gchar  *key)
+{
+  g_return_val_if_fail (TRAY_IS_SETTINGS (s), NULL);
+
+  return key != NULL ? g_hash_table_lookup (s->icons, key) : NULL;
+}
+
+
+
 const gchar *
 tray_settings_get_icon_override (TraySettings *s,
                                  const gchar  *key)
 {
+  const gchar *choice;
+
   g_return_val_if_fail (TRAY_IS_SETTINGS (s), NULL);
 
-  return key != NULL ? g_hash_table_lookup (s->icons, key) : NULL;
+  if (key == NULL)
+    return NULL;
+
+  choice = g_hash_table_lookup (s->icons, key);
+  if (g_strcmp0 (choice, TRAY_ICON_OWN) == 0)
+    return NULL;
+  if (choice != NULL)
+    return choice;
+
+  return default_icon_for (key);
 }
 
 
diff --git a/src/to-settings.h b/src/to-settings.h
index f31aae0..6f97b3b 100644
--- a/src/to-settings.h
+++ b/src/to-settings.h
@@ -68,9 +68,17 @@ void     tray_settings_forget                (TraySettings *s, const gchar *key)
 void     tray_settings_move                  (TraySettings *s, const gchar *key,
                                               const gchar *anchor, gboolean after);
 
-/* Ícono elegido por el usuario para una app (nombre del tema o ruta de
- * archivo), en lugar del que manda la app. NULL o "" = el de la app */
+/* Valor guardado que significa "usar el ícono propio de la app", aunque
+ * exista un ícono por defecto para ella (ver default_icon_for) */
+#define TRAY_ICON_OWN "-"
+
+/* Ícono a usar para una app en lugar del que manda (nombre del tema o ruta
+ * de archivo): el elegido por el usuario o, si no eligió, uno por defecto
+ * para apps conocidas que se ven mal. NULL = el de la app */
 const gchar *tray_settings_get_icon_override (TraySettings *s, const gchar *key);
+/* Solo lo elegido por el usuario: NULL (nada), TRAY_ICON_OWN o un ícono */
+const gchar *tray_settings_get_icon_choice   (TraySettings *s, const gchar *key);
+/* @icon: un ícono, TRAY_ICON_OWN, o NULL / "" para volver al por defecto */
 void     tray_settings_set_icon_override     (TraySettings *s, const gchar *key,
                                               const gchar *icon);
 
