diff --git a/data/icon-defaults.conf b/data/icon-defaults.conf
new file mode 100644
index 0000000..c90f802
--- /dev/null
+++ b/data/icon-defaults.conf
@@ -0,0 +1,18 @@
+# Tray Overflow: íconos por defecto para apps cuyo ícono se ve mal.
+#
+# Una línea por app:   clave=ícono;ícono;...
+#  - clave: la que muestra "xfconf-query -c xfce4-panel -p
+#    /plugins/plugin-N/known-items". Si termina en '*', vale para todas
+#    las claves que empiezan así.
+#  - ícono: nombre del tema de íconos o ruta de un archivo. Se usa el
+#    primero que exista; si no existe ninguno, se ve el de la app.
+#
+# Para agregar o cambiar apps sin tocar este archivo, crear uno igual en
+# ~/.config/xfce4/trayoverflow/icon-defaults.conf (tiene prioridad).
+# Lo que se elija en Propiedades → Elementos → "Ícono…" gana siempre.
+
+# JDownloader (Java): el ícono sale como puntos sueltos o un cuadrado blanco
+org-jdownloader-*=jdownloader;org.jdownloader.JDownloader
+
+# Clipman: con algunos tamaños el ícono se ve mal
+xfce4-clipman=xfce4-clipman-plugin;org.xfce.clipman
